<?xml version="1.0"?>
<package format="3">
  <name>ioniq5_ecan</name>
  <version>0.1.0</version>
  <description>Low-latency ROS 2 to Red Panda controller for a Hyundai Ioniq 5 HDA1 research vehicle.</description>

  <maintainer email="kelvin926@users.noreply.github.com">kelvin926</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>libusb-1.0</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>python3-usb1</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
