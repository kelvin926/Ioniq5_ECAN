diff --git a/opendbc/safety/tests/test_hyundai_canfd.py b/opendbc/safety/tests/test_hyundai_canfd.py
index 6cec7376..33333333 100755
--- a/opendbc/safety/tests/test_hyundai_canfd.py
+++ b/opendbc/safety/tests/test_hyundai_canfd.py
@@ -284,5 +284,87 @@ class TestHyundaiCanfdLFASteeringLongAltButtons(TestHyundaiCanfdLFASteeringLongB
     pass
 
 
+class TestHyundaiCanfdSplitButtonArm(unittest.TestCase):
+
+  SPLIT_BUTTON_ARM = 1024
+  ECAN_ONLY = 2048
+
+  def setUp(self):
+    self.packer = CANPackerSafety("hyundai_canfd_generated")
+    self.safety = libsafety_py.libsafety
+
+  def _set_mode(self, alternate, split_arm):
+    param = HyundaiSafetyFlags.EV_GAS | HyundaiSafetyFlags.CAMERA_SCC
+    if alternate:
+      param |= HyundaiSafetyFlags.CANFD_ALT_BUTTONS
+    if split_arm:
+      param |= self.SPLIT_BUTTON_ARM
+    self.safety.set_safety_hooks(CarParams.SafetyModel.hyundaiCanfd, param)
+    self.safety.init_tests()
+
+  def _lda_button_msg(self, alternate, pressed):
+    name = "CRUISE_BUTTONS_ALT" if alternate else "CRUISE_BUTTONS"
+    values = {"LDA_BTN": pressed}
+    return self.packer.make_can_msg_safety(name, 0, values)
+
+  def test_lda_rising_edge_is_opt_in(self):
+    for alternate in (False, True):
+      with self.subTest(alternate=alternate):
+        self._set_mode(alternate, False)
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, False))
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, True))
+        self.assertFalse(self.safety.get_controls_allowed())
+
+        self._set_mode(alternate, True)
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, False))
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, True))
+        self.assertTrue(self.safety.get_controls_allowed())
+
+        self.safety.set_controls_allowed(False)
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, True))
+        self.assertFalse(self.safety.get_controls_allowed())
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, False))
+        self.safety.safety_rx_hook(self._lda_button_msg(alternate, True))
+        self.assertTrue(self.safety.get_controls_allowed())
+
+  def test_ecan_only_blocks_both_forwarding_directions(self):
+    param = HyundaiSafetyFlags.EV_GAS | self.SPLIT_BUTTON_ARM | self.ECAN_ONLY
+    self.safety.set_safety_hooks(CarParams.SafetyModel.hyundaiCanfd, param)
+    self.safety.init_tests()
+    self.assertEqual(-1, self.safety.safety_fwd_hook(0, 0x123))
+    self.assertEqual(-1, self.safety.safety_fwd_hook(2, 0x123))
+
+  def test_ecan_only_allows_only_required_tester_present(self):
+    tester_present = b"\x02\x3E\x80\x00\x00\x00\x00\x00"
+    wrong_payload = b"\x03\x28\x83\x01\x00\x00\x00\x00"
+
+    for longitudinal in (False, True):
+      with self.subTest(longitudinal=longitudinal):
+        param = HyundaiSafetyFlags.EV_GAS | self.SPLIT_BUTTON_ARM | self.ECAN_ONLY
+        if longitudinal:
+          param |= HyundaiSafetyFlags.LONG
+        self.safety.set_safety_hooks(CarParams.SafetyModel.hyundaiCanfd, param)
+        self.safety.init_tests()
+
+        self.assertTrue(self.safety.safety_tx_hook(
+          libsafety_py.make_CANPacket(0x730, 0, tester_present)))
+        self.assertFalse(self.safety.safety_tx_hook(
+          libsafety_py.make_CANPacket(0x730, 0, wrong_payload)))
+        self.assertFalse(self.safety.safety_tx_hook(
+          libsafety_py.make_CANPacket(0x730, 1, tester_present)))
+        self.assertEqual(longitudinal, self.safety.safety_tx_hook(
+          libsafety_py.make_CANPacket(0x7D0, 0, tester_present)))
+        self.assertFalse(self.safety.safety_tx_hook(
+          libsafety_py.make_CANPacket(0x7D0, 0, wrong_payload)))
+
+    param = HyundaiSafetyFlags.EV_GAS | self.SPLIT_BUTTON_ARM
+    self.safety.set_safety_hooks(CarParams.SafetyModel.hyundaiCanfd, param)
+    self.safety.init_tests()
+    self.assertFalse(self.safety.safety_tx_hook(
+      libsafety_py.make_CANPacket(0x730, 0, tester_present)))
+    self.assertFalse(self.safety.safety_tx_hook(
+      libsafety_py.make_CANPacket(0x7D0, 0, tester_present)))
+
+
 if __name__ == "__main__":
   unittest.main()
