@@ -47,6 +47,8 @@
 
 static bool hyundai_canfd_alt_buttons = false;
 static bool hyundai_canfd_lka_steer_msg_alt = false;
+static bool hyundai_canfd_split_button_arm = false;
+static bool hyundai_canfd_lda_button_prev = false;
 
 static unsigned int hyundai_canfd_get_lka_addr(void) {
   return hyundai_canfd_lka_steer_msg_alt ? 0x110U : 0x50U;
@@ -84,15 +86,25 @@ static void hyundai_canfd_rx_hook(const CANPacket_t *msg) {
     const unsigned int button_addr = hyundai_canfd_alt_buttons ? 0x1aaU : 0x1cfU;
     if (msg->addr == button_addr) {
       bool main_button = false;
+      bool lda_button = false;
       int cruise_button = 0;
       if (msg->addr == 0x1cfU) {
         cruise_button = msg->data[2] & 0x7U;
         main_button = GET_BIT(msg, 19U);
+        lda_button = GET_BIT(msg, 23U);
       } else {
         cruise_button = (msg->data[4] >> 4) & 0x7U;
         main_button = GET_BIT(msg, 34U);
+        lda_button = GET_BIT(msg, 39U);
       }
       hyundai_common_cruise_buttons_check(cruise_button, main_button);
+
+      // Repository-local opt-in: allow an LDA rising edge to establish Panda's global
+      // controls_allowed. Host software selects lateral-only or combined control.
+      if (hyundai_canfd_split_button_arm && lda_button && !hyundai_canfd_lda_button_prev) {
+        controls_allowed = true;
+      }
+      hyundai_canfd_lda_button_prev = lda_button;
     }
 
     // gas press, different for EV, hybrid, and ICE models
