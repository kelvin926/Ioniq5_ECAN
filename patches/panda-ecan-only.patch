diff --git a/board/main.c b/board/main.c
index 1e624459..a046be58 100644
--- a/board/main.c
+++ b/board/main.c
@@ -40,6 +40,16 @@ void debug_ring_callback(uart_ring *ring) {
 // this is the only way to leave silent mode
 void set_safety_mode(uint16_t mode, uint16_t param) {
   uint16_t mode_copy = mode;
+  #ifdef IONIQ5_ECAN_ONLY
+    const uint16_t ioniq5_ecan_only_param = 2048U;
+    const bool ecan_only_requested =
+      (mode_copy == SAFETY_HYUNDAI_CANFD) && GET_FLAG(param, ioniq5_ecan_only_param);
+    if (ecan_only_requested && (harness.status != HARNESS_STATUS_NORMAL)) {
+      print("Error: ECAN-only mode requires normal harness orientation. Falling back to SILENT\n");
+      mode_copy = SAFETY_SILENT;
+      param = 0U;
+    }
+  #endif
   int err = set_safety_hooks(mode_copy, param);
   if (err == -1) {
     print("Error: safety set mode failed. Falling back to SILENT\n");
@@ -86,6 +96,14 @@ void set_safety_mode(uint16_t mode, uint16_t param) {
       break;
   }
   can_init_all();
+
+  #ifdef IONIQ5_ECAN_ONLY
+    // Physical CAN1 is logical ECAN bus 0 in the required normal orientation.
+    // Keep all unused transceivers off after set_can_mode() changes their GPIOs.
+    for (uint8_t transceiver = 2U; transceiver <= 4U; transceiver++) {
+      current_board->enable_can_transceiver(transceiver, false);
+    }
+  #endif
 }
 
 bool is_car_safety_mode(uint16_t mode) {
diff --git a/board/sys/power_saving.h b/board/sys/power_saving.h
index c0c82212..c3e76dc0 100644
--- a/board/sys/power_saving.h
+++ b/board/sys/power_saving.h
@@ -14,7 +14,13 @@ void enable_can_transceivers(bool enabled) {
   // Leave main CAN always on for CAN-based ignition detection
   uint8_t main_bus = (harness.status == HARNESS_STATUS_FLIPPED) ? 3U : 1U;
   for(uint8_t i=1U; i<=4U; i++){
-    current_board->enable_can_transceiver(i, (i == main_bus) || enabled);
+    bool transceiver_enabled = (i == main_bus) || enabled;
+    #ifdef IONIQ5_ECAN_ONLY
+      // This build is dedicated to harness orientation 1: physical CAN1 is ECAN.
+      // No other CAN controller participates in control or ignition detection.
+      transceiver_enabled = i == 1U;
+    #endif
+    current_board->enable_can_transceiver(i, transceiver_enabled);
   }
 }
 
